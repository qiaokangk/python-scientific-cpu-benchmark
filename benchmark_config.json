{
  "benchmark": {
    "calibration_max_inner_loops": 100000,
    "enforce_threadpoolctl": true,
    "execution_order": "by_benchmark",
    "gc_between_repeats": true,
    "max_memory_gb": 4.0,
    "multi_thread_count": "auto",
    "random_seed": 20260606,
    "repeats": 5,
    "target_case_s": 10.0,
    "target_repeat_s": 0.0,
    "thread_modes": [
      "single",
      "multi"
    ],
    "warmups": 1
  },
  "modules": {
    "dense_cholesky": {
      "enabled": true,
      "n": 3600
    },
    "dense_hermitian_eigvalsh": {
      "enabled": true,
      "n": 1536
    },
    "scipy_hermitian_eigh": {
      "check_finite": false,
      "driver": "evd",
      "enabled": true,
      "input_seed_name": "dense_hermitian_eigvalsh",
      "n": 1536
    },
    "dense_matmul_complex128": {
      "enabled": true,
      "n": 1536
    },
    "dense_matmul_float64": {
      "enabled": true,
      "n": 3072
    },
    "dense_nonhermitian_eigvals": {
      "enabled": true,
      "n": 640
    },
    "scipy_nonhermitian_eigvals": {
      "check_finite": false,
      "enabled": true,
      "input_seed_name": "dense_nonhermitian_eigvals",
      "n": 640
    },
    "dense_qr": {
      "enabled": true,
      "n": 1800
    },
    "dense_svd": {
      "enabled": true,
      "n": 1200
    },
    "scipy_svdvals": {
      "check_finite": false,
      "enabled": true,
      "input_seed_name": "dense_svd",
      "lapack_driver": "gesdd",
      "n": 1200
    },
    "einsum_tensor_contraction": {
      "a": 64,
      "b": 64,
      "c": 512,
      "d": 64,
      "e": 32,
      "enabled": true
    },
    "fft_3d_complex128": {
      "backend": "scipy_if_available",
      "enabled": true,
      "shape": [
        256,
        256,
        192
      ],
      "use_scipy_workers": false
    },
    "least_squares_lstsq": {
      "enabled": true,
      "m": 5000,
      "n": 1200,
      "nrhs": 8
    },
    "linear_solve": {
      "enabled": true,
      "n": 3000,
      "nrhs": 32
    },
    "numba_njit_loop": {
      "enabled": true,
      "n": 40000000
    },
    "numba_prange_loop": {
      "enabled": true,
      "n": 50000000
    },
    "python_loop": {
      "enabled": true,
      "iterations": 8000000
    },
    "reduction_norm": {
      "enabled": true,
      "n": 128000000
    },
    "scipy_distance_cdist": {
      "d": 16,
      "enabled": true,
      "m": 12000,
      "n": 8000
    },
    "scipy_ndimage_gaussian_filter": {
      "enabled": true,
      "shape": [
        4096,
        4096
      ],
      "sigma": 2.0
    },
    "scipy_signal_fftconvolve": {
      "enabled": true,
      "kernel_shape": [
        129,
        129
      ],
      "shape": [
        3072,
        3072
      ]
    },
    "sort_argsort": {
      "enabled": true,
      "n": 4000000
    },
    "sparse_eigsh": {
      "enabled": true,
      "k": 6,
      "maxiter": 400,
      "n": 8000,
      "tol": 1e-06
    },
    "sparse_matvec_csr": {
      "enabled": true,
      "loops": 200,
      "n": 120000,
      "nnz_per_row": 12
    },
    "vectorized_elementwise": {
      "enabled": true,
      "n": 8000000
    }
  },
  "monitoring": {
    "enabled": true,
    "interval_s": 0.25,
    "per_cpu": false,
    "process_cpu": true,
    "process_memory": true
  },
  "output": {
    "directory": "benchmark_results",
    "make_json": true,
    "make_pdf": true,
    "make_text": true,
    "prefix": "cpu_python_scientific"
  }
}
